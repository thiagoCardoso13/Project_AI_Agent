# Copie para .env (ou use .streamlit/secrets.toml) e preencha. NUNCA suba a chave pro GitHub.
LLM_PROVIDER=gemini            # gemini | groq | openrouter | ollama
# LLM_MODEL=gemini-3.5-flash   # opcional: troca o modelo do provedor
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MAX_QUESTIONS=10               # limite de perguntas por sessão (demo pública)
