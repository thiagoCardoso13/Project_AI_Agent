# Copy to .env and fill in. NEVER push your key to GitHub.
LLM_PROVIDER=gemini            # gemini | groq | openrouter | ollama
# LLM_MODEL=gemini-3.5-flash   # optional: override the provider's model
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MAX_QUESTIONS=10               # questions per session limit (public demo)
